{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js, TypeScript, Express, and PostgreSQL backend",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test src/*.test.ts src/config/*.test.ts src/module/chat/*.test.ts src/module/internal/*.test.ts",
    "eval:live": "tsx src/scripts/evaluate_live.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
